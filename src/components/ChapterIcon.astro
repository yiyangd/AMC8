---
interface Props {
  id: number;
  size?: number;
  class?: string;
}
const { id, size = 24, class: className = '' } = Astro.props;
const chapter = Number(id);
---

<svg
  class:list={['chapter-svg', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {(chapter === 1 || chapter < 1 || chapter > 7) && (
    <g>
      <path d="M3 6h6M6 3v6M3.6 14.4l4.8 4.8m0-4.8-4.8 4.8" />
      <path class="icon-accent" stroke="currentColor" d="M14 4.5h7m-7 4h7M14 17h7" />
      <circle class="icon-accent" cx="17.5" cy="13.5" r=".75" fill="currentColor" stroke="none" />
      <circle class="icon-accent" cx="17.5" cy="20.5" r=".75" fill="currentColor" stroke="none" />
    </g>
  )}
  {chapter === 2 && (
    <g>
      <path d="M4 3v17h17M4 16l5-3 5-6 6-3" />
      <circle class="icon-accent" cx="14" cy="7" r="2" fill="var(--color-accent, #e77736)" stroke="var(--color-accent, #e77736)" />
      <path d="M2 6h2m0 6H2m6 8v2m6-2v2" stroke-opacity=".45" stroke-width="1.2" />
    </g>
  )}
  {chapter === 3 && (
    <g>
      <path d="m3 20 9-17 9 17H3Z" />
      <circle class="icon-accent" cx="12" cy="13.2" r="4.1" />
    </g>
  )}
  {chapter === 4 && (
    <g>
      <path d="M9 3 6 21M17 3l-3 18" />
      <path class="icon-accent" d="M4 8.5h17M3 15.5h17" />
    </g>
  )}
  {chapter === 5 && (
    <g>
      <path d="m12 4-6 6m6-6 6 6M6 10l-3 9m3-9 3 9m9-9-3 9m3-9 3 9" stroke-opacity=".7" />
      <circle cx="12" cy="4" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="6" cy="10" r="1.5" fill="currentColor" stroke="none" />
      <circle cx="18" cy="10" r="1.5" fill="currentColor" stroke="none" />
      <g class="icon-accent" fill="currentColor" stroke="none">
        <circle cx="3" cy="19" r="1.6" /><circle cx="9" cy="19" r="1.6" />
        <circle cx="15" cy="19" r="1.6" /><circle cx="21" cy="19" r="1.6" />
      </g>
    </g>
  )}
  {chapter === 6 && (
    <g>
      <path d="M2 21h20" stroke-width="1.3" />
      <path d="M5 17v-5h2v5M11 17V7h2v10M17 17V3h2v14" />
      <path class="icon-accent" d="M11 17V7h2v10" />
    </g>
  )}
  {chapter === 7 && (
    <g>
      <path d="M6.5 5h11M5.9 6.7l5.2 11.2m7-11.2-5.2 11.2M6.7 6.4 12 10l5.3-3.6" stroke-opacity=".7" />
      <circle cx="5" cy="5" r="2" fill="white" />
      <circle cx="19" cy="5" r="2" fill="white" />
      <circle class="icon-accent" cx="12" cy="19" r="2" fill="white" />
      <circle cx="12" cy="10" r="1.1" fill="currentColor" stroke="none" />
    </g>
  )}
</svg>
