---
import Layout from '../layouts/Layout.astro';
import { challengeSections } from '../data/monster-challenge-sections';
import { choiceKeys } from '../data/monster-challenge-types';
import { questionById, questionUrl, sectionUrl, sections, url } from '../lib/content';
import '../styles/monster-challenge.css';

const sectionCards = challengeSections.map(({ id, levels }) => ({ section: sections.find(item => item.id === id)!, levels }));
const sectionLinks = Object.fromEntries(sectionCards.map(({ section }) => [section.id, sectionUrl(section)]));
const encounters = challengeSections.flatMap(({ levels }) => levels);
const sources = Object.fromEntries(encounters.map(({ sourceId }) => [sourceId, questionUrl(questionById.get(sourceId)!)]));
const figures = Object.fromEntries(encounters.flatMap(({ sourceId, figure }) => figure ? [[sourceId, url(figure.source)]] : []));
const directions = [
  { key: 'up', arrow: '↑', label: 'Move up' },
  { key: 'left', arrow: '←', label: 'Move left' },
  { key: 'down', arrow: '↓', label: 'Move down' },
  { key: 'right', arrow: '→', label: 'Move right' },
] as const;
---

<Layout title="Monster Challenge">
  <div class="monster-game" data-challenge data-state="intro" data-sources={JSON.stringify(sources)} data-figures={JSON.stringify(figures)} data-section-links={JSON.stringify(sectionLinks)}>
    <nav class="monster-navigation" aria-label="Challenge navigation">
      <a class="monster-back" href={url()} data-workbook-link><span aria-hidden="true">←</span> <span data-field="workbook-back">Back to workbook</span></a>
      <button type="button" class="monster-button" data-action="choose" hidden>Choose section</button>
    </nav>
    <header class="monster-heading">
      <div>
        <p class="monster-kicker">AMC 8</p>
        <h1>Monster Challenge</h1>
      </div>
      <button type="button" class="monster-button monster-language" data-action="language" aria-pressed="false" lang="zh">中文辅助</button>
    </header>

    <section class="monster-intro" data-panel="intro" aria-labelledby="monster-intro-title">
      <div class="monster-arena monster-intro-art" aria-hidden="true">
        <div class="monster-platform"></div>
        <div class="monster-foe monster-intro-foe">
          <div class="monster-horn monster-horn--left"></div>
          <div class="monster-horn monster-horn--right"></div>
          <div class="monster-claw monster-claw--left"></div>
          <div class="monster-claw monster-claw--right"></div>
          <div class="monster-hull"></div>
          <div class="monster-eyeplate"><i></i><i></i><i></i></div>
          <div class="monster-targets">
            {choiceKeys.map(choice => <span class="monster-target">{choice}</span>)}
          </div>
        </div>
        <div class="monster-player">
          <span class="monster-player-body"></span>
          <span class="monster-player-helmet"></span>
          <span class="monster-blaster"></span>
        </div>
      </div>
      <div class="monster-intro-copy">
        <h2 id="monster-intro-title">Choose a section <span lang="zh">选择章节</span></h2>
        <div class="monster-section-cards">
          {sectionCards.map(({ section, levels }) => (
            <button type="button" class="monster-section-card" data-start-section={section.id}>
              <span class="monster-section-meta"><span>Section {section.id}</span><span>{levels.length} levels</span></span>
              <strong>{section.titleEn}</strong>
              <span class="monster-section-zh" lang="zh">{section.titleZh}</span>
              <span class="monster-section-arrow" aria-hidden="true">→</span>
            </button>
          ))}
        </div>
        <ul>
          <li><strong>Move</strong> with WASD, arrow keys, or the touch controls.</li>
          <li><strong>Shoot</strong> by clicking or tapping a moving A, B, or C target. With a keyboard, tab to a target and press Enter for each shot.</li>
          <li><strong>Break the armor</strong> with three correct hits per step. A wrong answer gives you a hint.</li>
          <li><strong>Dodge</strong> when the monster marks a ring under you.</li>
        </ul>
      </div>
    </section>

    <section class="monster-stage" data-panel="game" aria-label="Monster encounter" hidden>
      <section class="monster-question" aria-label="Problem and answer choices">
        <h2 data-field="strategy"></h2>
        <p class="monster-stem" data-field="stem"></p>
        <p class="challenge-zh" lang="zh" data-field="stem-zh" hidden></p>
        <button type="button" class="question-image-button monster-figure" data-level-figure aria-label="Enlarge question figure" aria-describedby="monster-figure-description" hidden>
          <img data-level-figure-image alt="" />
        </button>
        <p class="sr-only" id="monster-figure-description" hidden></p>
        <table class="monster-number-grid" data-level-grid aria-label="Number array from the question" hidden><tbody></tbody></table>
        <ol class="monster-unlocked" data-results aria-label="Steps completed"></ol>
        <div class="monster-step" aria-label="Current step">
          <span>Step <span data-field="step">1</span> of <span data-field="step-total"></span></span>
        </div>
        <h3 class="monster-prompt" data-field="prompt" tabindex="-1"></h3>
        <p class="challenge-zh" lang="zh" data-field="prompt-zh" hidden></p>
        <ul class="monster-choices" aria-label="Answer choices">
          {choiceKeys.map(choice => (
            <li class="monster-choice">
              <b aria-hidden="true">{choice}</b>
              <span id={`monster-option-${choice}`} data-option={choice}></span>
            </li>
          ))}
        </ul>
        <div role="status" aria-atomic="true">
          <p class="monster-feedback" data-field="feedback" hidden></p>
          <p class="challenge-zh" lang="zh" data-field="feedback-zh" hidden></p>
        </div>
        <button type="button" class="monster-button monster-button--primary monster-recover" data-action="recover" hidden>Continue this step</button>
      </section>

      <div class="monster-field">
        <div class="monster-hud">
          <div class="monster-hud-foe">
            <span class="monster-hud-count"><span data-field="section-number"></span> · Level <span data-field="encounter">1</span> of <span data-field="encounter-total"></span></span>
            <strong data-field="monster"></strong>
          </div>
          <div class="monster-hud-end">
            <span class="monster-shields">
              <span class="monster-shield-icons" aria-hidden="true"><i class="monster-shield"></i><i class="monster-shield"></i><i class="monster-shield"></i></span>
              <span>Shields <strong data-field="shields">3</strong>/3</span>
            </span>
          </div>
        </div>
        <p class="monster-attack-status" role="status" aria-atomic="true">
          <span data-attack-status>Watch for the warning ring.</span>
          <span data-attack-status-zh lang="zh" hidden></span>
        </p>
        <div class="monster-arena" data-arena data-monster="0" aria-label="Arena">
          <div class="monster-platform"></div>
          <div class="monster-hit-count">
            <span>Hits <strong data-field="hits">0 / 3</strong></span>
            <progress data-charge max="3" value="0" aria-label="Correct hits for this step"></progress>
          </div>
          <div class="monster-attack-marker" data-attack-marker aria-hidden="true" hidden></div>
          <div class="monster-player" data-player aria-hidden="true">
            <span class="monster-player-body"></span>
            <span class="monster-player-helmet"></span>
            <span class="monster-blaster" data-muzzle></span>
          </div>
          <div class="monster-foe" data-foe>
            <div class="monster-horn monster-horn--left"></div>
            <div class="monster-horn monster-horn--right"></div>
            <div class="monster-claw monster-claw--left"></div>
            <div class="monster-claw monster-claw--right"></div>
            <div class="monster-hull"></div>
            <div class="monster-eyeplate" data-attack-emitter><i></i><i></i><i></i></div>
            <div class="monster-targets" role="group" aria-label="Shoot an answer target">
              {choiceKeys.map(choice => <button type="button" class="monster-target" data-target={choice} aria-label={`Target ${choice}`} aria-describedby={`monster-option-${choice}`} aria-disabled="true" hidden>{choice}</button>)}
            </div>
          </div>
          <div class="monster-attack-projectile" data-attack-projectile aria-hidden="true" hidden></div>
          <svg class="monster-beam" data-beam viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            <line data-beam-line x1="0" y1="0" x2="0" y2="0"></line>
          </svg>
        </div>
        <div class="monster-controls">
          <div class="monster-keys"><span>Move</span><kbd>W A S D</kbd><span>or</span><kbd>↑ ← ↓ →</kbd></div>
          <div class="monster-dpad" role="group" aria-label="Touch movement">
            {directions.map(({ key, arrow, label }) => <button type="button" aria-label={label} data-move={key}>{arrow}</button>)}
          </div>
        </div>
      </div>
    </section>

    <section class="monster-review" data-panel="review" aria-labelledby="monster-review-title" hidden>
      <p class="monster-kicker">Armor cleared · <span data-field="review-source-id"></span></p>
      <h2 id="monster-review-title" data-field="review-title" tabindex="-1"></h2>
      <p class="challenge-zh" lang="zh" data-field="review-title-zh" hidden></p>
      <ol data-review-steps></ol>
      <div class="monster-review-actions">
        <button type="button" class="monster-button monster-button--primary" data-action="next">Next monster</button>
        <a class="monster-source" data-review-link href={url()} target="_blank" rel="noopener">Original question <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="monster-summary" data-panel="summary" aria-labelledby="monster-summary-title" tabindex="-1" hidden>
      <h2 id="monster-summary-title" data-field="summary-title">Challenge complete</h2>
      <p><strong class="monster-score" data-field="score"></strong> steps correct on the first try</p>
      {challengeSections.map(({ id, levels }) => (
        <div class="monster-summary-list" data-section-review={id} hidden>
          {levels.map(({ sourceId }) => (
            <details data-review-card={sourceId}>
              <summary data-card-title>{sourceId}</summary>
              <ol data-card-steps></ol>
              <a class="monster-source" href={sources[sourceId]} target="_blank" rel="noopener">Original question <span aria-hidden="true">↗</span></a>
            </details>
          ))}
        </div>
      ))}
      <div class="monster-summary-actions">
        <button type="button" class="monster-button monster-button--primary" data-action="restart">Replay this section</button>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '../scripts/monster-challenge';
</script>
